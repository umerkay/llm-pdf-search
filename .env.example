# OpenAI-compatible LLM server.
# For a server running on the host computer, use host.docker.internal.
# Change the host and port if the server is elsewhere or uses another port.
OPENAI_BASE_URL=http://host.docker.internal:1235/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=local-model
OPENAI_CONTEXT_WINDOW=8192

# Optional Discord notifications. Leave empty to disable notifications.
DISCORD_WEBHOOK_URL=
RESEARCH_LIBRARY_HOST_PATH=